# Copy to ".env" next to server.py. Existing OS env vars are not overwritten.
# Paths: use ~ or relative to the user home. Never hardcode C:\Users\<nome>.

# Root de dados (default: ~/Documents/ServerCRON  ->  Path.home() / Documents / ServerCRON)
# SERVERCRON_DATA_ROOT=~/Documents/ServerCRON

# Pasta das automacoes (.py). Default: ./automacoes (junto de server.py)
# SERVERCRON_AUTOMAOES_DIR=./automacoes

# Planilha na raiz do projeto (default: ./registro_automacoes.xlsx)
# SERVERCRON_REGISTRO_XLSX=./registro_automacoes.xlsx

# Porta HTTP (default 5001)
# SERVERCRON_PORT=5001

# Bind (default 127.0.0.1). Use 0.0.0.0 para rede local (wifi/ethernet).
# Se sair de 127.0.0.1/localhost, e obrigatorio ter alguma protecao configurada:
# SERVERCRON_API_TOKEN definido OU pelo menos 1 email ativo na aba USERS da planilha
# (login por email no painel). O servidor recusa arrancar exposto sem nenhuma das duas.
# SERVERCRON_HOST=127.0.0.1

# Login: se a aba USERS da planilha tiver pelo menos 1 email ativo, o painel exige
# login por codigo enviado ao email (OTP) — email sozinho NAO e segredo, entao o login
# so e concluido quando a pessoa prova que recebeu o codigo na propria caixa de entrada.
# Isso precisa de SMTP configurado (variaveis abaixo) para funcionar.
#
# SERVERCRON_API_TOKEN e so usado se a aba USERS estiver vazia (modo legado, sem email/OTP):
# Gere um valor aleatorio (ex.: python -c "import secrets;print(secrets.token_urlsafe(32))").
# Se USERS e API_TOKEN estiverem vazios, o painel fica aberto (ok so em uso local 127.0.0.1).
# SERVERCRON_API_TOKEN=

# SMTP para enviar o codigo de login (obrigatorio se a aba USERS tiver algum email).
# Gmail: ative verificacao em 2 etapas e gere uma "Senha de app" em
# myaccount.google.com/apppasswords — a senha normal da conta NAO funciona aqui.
# SERVERCRON_SMTP_HOST=smtp.gmail.com
# SERVERCRON_SMTP_PORT=465
# SERVERCRON_SMTP_USER=seuemail@gmail.com
# SERVERCRON_SMTP_PASSWORD=

# Quanto tempo (segundos) o codigo de login por email fica valido. Default: 120 (2 min).
# SERVERCRON_OTP_TTL_SEC=120

# Quanto tempo (segundos) uma sessao ja autenticada fica valida antes de pedir login de novo.
# Default: 36000 (10 horas).
# SERVERCRON_SESSION_TTL_SEC=36000

# Mata a automacao se ela passar deste tempo em segundos (evita 1 script preso a ocupar 1 slot para sempre).
# 0 = sem limite.
# SERVERCRON_JOB_TIMEOUT_SEC=3600

# Intervalo minimo (segundos) entre disparos manuais da MESMA automacao pelo painel (anti double-click).
# SERVERCRON_MANUAL_RUN_COOLDOWN_SEC=2

# Abrir browser ao iniciar (1/0)
# SERVERCRON_OPEN_BROWSER=1

# Saltar install_deps.bat no arranque (1/0). Use 1 se as deps ja estiverem instaladas.
# SERVERCRON_SKIP_REQUIREMENTS_PIP=0

# Intervalo de hot-reload da planilha em minutos (default 5)
# SERVERCRON_RELOAD_MINUTES=5

# Max automacoes em paralelo (default 5)
# SERVERCRON_MAX_CONCURRENT=5

# Quantos horarios em atraso por script enfileirar de cada vez (default 5)
# SERVERCRON_CATCHUP_PER_SCRIPT=5

# Fuso dos crons (default America/Sao_Paulo)
# SERVERCRON_TZ=America/Sao_Paulo

# Clima Sao Paulo via Open-Meteo (cache em segundos, default 900)
# SERVERCRON_WEATHER_CACHE_SEC=900
# SERVERCRON_WEATHER_LAT=-23.5505
# SERVERCRON_WEATHER_LON=-46.6333
